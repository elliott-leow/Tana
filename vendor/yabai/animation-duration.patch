+//
+// LOCAL PATCH -- Dock space-transition animation duration.
+//
+// Dock hardcodes the duration of the space-switch slide as an FMOV immediate
+// (macOS 26: `fmov d0, #0.25` at the call site located by get_fix_animation_pattern).
+// Upstream yabai overwrites that instruction with `movi d0, #0`, which removes the
+// slide for *every* space switch -- cmd+tab, Dock clicks and the numeric
+// mission-control hotkeys included -- and declined to make it configurable
+// (yabai issue #1501).
+//
+// This build rewrites the immediate instead of zeroing it, so the slide survives but
+// finishes sooner. The duration is read at injection time from
+// ~/.config/yabai/space-animation-duration (a single float, in seconds), falling back
+// to SA_SPACE_ANIM_DEFAULT. Retuning therefore needs only a Dock reinject
+// (`sudo yabai --load-sa`), not a rebuild.
+//
+// ARM64's FMOV scalar immediate can only encode +/- n/16 * 2^r for n in [16,31] and
+// r in [-3,4], so the shortest non-zero duration available is 0.125s and the encoder
+// snaps whatever is requested to the nearest representable value. A value of 0 (or
+// less) restores upstream's behaviour and removes the animation entirely.
+//
+
+#define SA_SPACE_ANIM_DEFAULT 0.125
+#define SA_SPACE_ANIM_FILE    "/.config/yabai/space-animation-duration"
+
+static double sa_space_animation_duration(void)
+{
+    double seconds = SA_SPACE_ANIM_DEFAULT;
+
+    const char *home = getenv("HOME");
+    if (!home) return seconds;
+
+    char path[PATH_MAX];
+    snprintf(path, sizeof(path), "%s%s", home, SA_SPACE_ANIM_FILE);
+
+    FILE *handle = fopen(path, "r");
+    if (!handle) return seconds;
+
+    double value;
+    if (fscanf(handle, "%lf", &value) == 1 && value >= 0.0 && value <= 1.0) {
+        seconds = value;
+    } else {
+        NSLog(@"[yabai-sa] %s is unreadable or out of range [0,1]; using %.6fs", path, seconds);
+    }
+
+    fclose(handle);
+    return seconds;
+}
+
+#ifdef __arm64__
+//
+// Encode `fmov d0, #<nearest representable value to seconds>`.
+// The 8-bit immediate abcdefgh expands to a double as
+//   sign = a, exponent = ~b : b*8 : cd, fraction = efgh : 48 zero bits
+// (ARM VFPExpandImm). Only positive values are considered.
+//
+static uint32_t sa_encode_fmov_d0(double seconds, double *encoded)
+{
+    int best_imm8 = -1;
+    double best_delta = 0.0;
+    double best_value = 0.0;
+
+    for (int imm8 = 0; imm8 < 0x80; ++imm8) {
+        int b = (imm8 >> 6) & 1;
+        int c = (imm8 >> 5) & 1;
+        int d = (imm8 >> 4) & 1;
+
+        uint64_t exponent = ((uint64_t)(!b) << 10) | ((uint64_t)(b ? 0xFF : 0x00) << 2) | (c << 1) | d;
+        uint64_t bits     = (exponent << 52) | ((uint64_t)(imm8 & 0xF) << 48);
+
+        double value;
+        memcpy(&value, &bits, sizeof(value));
+
+        double delta = value > seconds ? value - seconds : seconds - value;
+        if (best_imm8 < 0 || delta < best_delta) {
+            best_imm8  = imm8;
+            best_delta = delta;
+            best_value = value;
+        }
+    }
+
+    if (encoded) *encoded = best_value;
+    return 0x1E601000 | ((uint32_t) best_imm8 << 13);
+}
+#endif
