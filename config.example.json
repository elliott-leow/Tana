{
  "settings": {
    "motionStrength": 1,
    "autofocus": "pointer-movement",
    "showStripMap": false,
    "stripWidths": [
      0.333333,
      0.5,
      0.666667,
      1
    ],
    "mod": "ctrl+alt",
    "snap": "center",
    "snapMagnet": 0.1,
    "newWindowPlacement": "center-gap",
    "hotReload": true,
    "hud": true,
    "inactiveOpacity": 1,
    "gaps": {
      "inner": 12,
      "top": 14,
      "bottom": 12,
      "left": 12,
      "right": 12
    },
    "border": {
      "enabled": true,
      "width": 2,
      "radius": 12,
      "active": "#66b8ff",
      "activeEnd": "#b48cff",
      "inactive": "#ffffff24",
      "attention": "#ffb454",
      "travel": true,
      "spin": 0
    },
    "animations": {
      "windows": {
        "duration": 0.36,
        "bounce": 0
      },
      "scroll": {
        "speed": 22
      },
      "overview": {
        "duration": 0.34
      },
      "open": "popin",
      "close": "shrink"
    },
    "overview": {
      "dim": 0.38
    },
    "commands": {
      "terminal": "open -na Ghostty",
      "browser": "open -a Firefox"
    },
    "snapThreshold": 0.15,
    "swipeGain": 1,
    "focusAfterScroll": "pointer",
    "dimInactive": 0.2,
    "strips": [
      "main",
      "web",
      "chat"
    ],
    "verticalSwipe": "overview",
    "attention": "badge",
    "haptics": true,
    "autoPip": true,
    "wallpaper": {
      "parallax": 0
    },
    "helper": {
      "autoReload": true,
      "command": "sudo -n /opt/homebrew/bin/yabai --load-sa"
    }
  },
  "shortcuts": {
    "left": "mod+left",
    "right": "mod+right",
    "move-left": "mod+shift+left",
    "move-right": "mod+shift+right",
    "float": "mod+f",
    "full": "mod+return",
    "center": "mod+c",
    "home": "mod+h",
    "pause": "mod+p",
    "reflow": "mod+r",
    "close": "mod+w",
    "terminal": "mod+t",
    "browser": "mod+b",
    "overview": "mod+o",
    "preset-width": "mod+1",
    "fit-two": "mod+2",
    "previous": "mod+tab",
    "undo": "mod+z",
    "consume": "mod+u",
    "expel": "mod+e",
    "up": "mod+up",
    "down": "mod+down",
    "utility-mark": "mod+m",
    "utility": "mod+space",
    "tabs": "mod+shift+t",
    "reload-config": "mod+shift+r",
    "commands": "mod+shift+p",
    "move-first": "mod+shift+,",
    "move-last": "mod+shift+.",
    "strip-up": "mod+k",
    "strip-down": "mod+j",
    "send-strip-up": "mod+shift+k",
    "send-strip-down": "mod+shift+j",
    "strip-1": "mod+7",
    "strip-2": "mod+8",
    "strip-3": "mod+9",
    "mark": "mod+'",
    "jump-mark": "mod+;",
    "fit-visible": "mod+-",
    "equalize": "mod+=",
    "sticky": "mod+s"
  },
  "appRules": {
    "com.apple.Safari": {
      "width": 0.666667,
      "floating": false,
      "openBesideCurrent": true,
      "strip": "web"
    },
    "com.apple.Notes": {
      "width": 760,
      "floating": false,
      "openBesideCurrent": true
    },
    "com.apple.Calculator": {
      "width": 420,
      "floating": true,
      "openBesideCurrent": false
    }
  },
  "exec": {
    "mod+shift+f": "open -a Finder"
  },
  "windowRules": [
    {
      "app": "org.mozilla.firefox",
      "title": "^Library$",
      "floating": true
    },
    {
      "title": "Inspector",
      "tabbed": true
    }
  ],
  "jump": {
    "mod+g": "com.mitchellh.ghostty",
    "mod+shift+b": {
      "app": "org.mozilla.firefox",
      "launch": "open -a Firefox"
    }
  }
}
